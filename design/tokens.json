{
  "$schema": "https://securedrop.local/design-tokens.schema.json",
  "name": "SecureDrop",
  "description": "Canonical design tokens for SecureDrop. Source of truth for the mobile app (app/src/theme/tokens.ts) and the website (web/src/styles/tokens.css). Values must stay identical across platforms.",
  "version": "1.0.0",
  "color": {
    "light": {
      "background": "#F7F8FA",
      "surface": "#FFFFFF",
      "surfaceVariant": "#EEF1F5",
      "border": "#DDE2EA",
      "text": "#0E1420",
      "textMuted": "#5C6675",
      "brand": "#2C5CE6",
      "brandContrast": "#FFFFFF",
      "success": "#12855F",
      "warning": "#9A6700",
      "danger": "#C62828",
      "dangerSurface": "#FDECEC"
    },
    "dark": {
      "background": "#0B0F16",
      "surface": "#141A24",
      "surfaceVariant": "#1C2431",
      "border": "#27303E",
      "text": "#E9EDF5",
      "textMuted": "#97A2B3",
      "brand": "#5B85FF",
      "brandContrast": "#08111F",
      "success": "#39C79A",
      "warning": "#E0A73B",
      "danger": "#FF6B6B",
      "dangerSurface": "#2A1717"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 12,
    "xl": 16,
    "pill": 999
  },
  "typography": {
    "title": { "fontSize": 24, "lineHeight": 30, "fontWeight": 700 },
    "heading": { "fontSize": 18, "lineHeight": 24, "fontWeight": 600 },
    "body": { "fontSize": 15, "lineHeight": 21, "fontWeight": 400 },
    "caption": { "fontSize": 13, "lineHeight": 18, "fontWeight": 400 },
    "mono": { "fontSize": 13, "lineHeight": 19, "fontWeight": 400 }
  }
}
