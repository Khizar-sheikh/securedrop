# Expo public environment — only EXPO_PUBLIC_* values are exposed to the app.
# Copy to .env and adjust. Never put secrets here: everything in this file
# is inlined into the JavaScript bundle and is readable by anyone.

# Backend base URL.
#   Android emulator: http://10.0.2.2:3000
#   iOS simulator:    http://localhost:3000
#   Physical device:  http://<your-machine-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
