{
  "name": "securedrop",
  "version": "0.1.0",
  "private": true,
  "description": "SecureDrop \u2014 secure mobile file sharing",
  "workspaces": [
    "backend",
    "app",
    "web"
  ],
  "scripts": {
    "backend": "npm run start:dev --workspace backend",
    "backend:build": "npm run build --workspace backend",
    "backend:test": "npm run test --workspace backend",
    "app": "npm run start --workspace app",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace app",
    "infra:check": "node backend/scripts/check-infra.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "web": "npm run start --workspace web",
    "web:build": "npm run build --workspace web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "react": "19.2.3"
  },
  "dependencies": {
    "react-native-markdown-display": "^7.0.2"
  }
}
