# SecureDrop local environment template.
# Copy to .env and generate your own secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the real .env file.

NODE_ENV=development
PORT=3000

# --- PostgreSQL (Docker) ---
POSTGRES_DB=securedrop
POSTGRES_USER=securedrop
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql://securedrop:change-me@localhost:5433/securedrop?schema=public

# --- Redis (Docker) ---
REDIS_PORT=6380
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6380

# --- Private object storage / MinIO (Docker) ---
STORAGE_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=securedrop-private
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_FORCE_PATH_STYLE=true

# --- Token secrets (48 random bytes, base64url) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
RECIPIENT_SESSION_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Uploads ---
UPLOAD_MAX_BYTES=104857600
# Max declared uncompressed size for zip/tar archives (zip-bomb mitigation)
# UPLOAD_MAX_UNCOMPRESSED_BYTES=1073741824
# Per-user simultaneous uploads
# UPLOAD_MAX_CONCURRENT=3

# --- App ---
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
# Send Strict-Transport-Security once TLS terminates in front of the app
# ENABLE_HSTS=true

# --- Brute-force protection (optional overrides) ---
# AUTH_MAX_FAILED_ATTEMPTS=10
# AUTH_FAIL_WINDOW=15m
# SHARE_PASSWORD_MAX_FAILED_ATTEMPTS=5
# SHARE_PASSWORD_FAIL_WINDOW=15m
