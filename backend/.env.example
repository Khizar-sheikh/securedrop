# SecureDrop backend environment
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
DATABASE_URL=postgresql://securedrop:changeme@localhost:5432/securedrop?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Private object storage (S3 compatible, never exposed to clients) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=securedrop-private
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme
STORAGE_FORCE_PATH_STYLE=true

# --- Token secrets: 48+ random bytes, base64url encoded ---
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
RECIPIENT_SESSION_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Uploads ---
UPLOAD_MAX_BYTES=104857600

# --- App ---
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081
