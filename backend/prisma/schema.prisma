// Prisma schema — SecureDrop
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

/// Explicit role for website/admin authorization. Authorization always checks
/// the database, never the token, so demotions take effect immediately.
enum UserRole {
  USER
  ADMIN
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique // stored lowercase
  passwordHash String
  status       AccountStatus @default(ACTIVE)
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  files       File[]
  notes       Note[]
  shares      Share[]
  auditEvents AuditEvent[]
}

/// Uploaded file metadata. Content lives in private object storage under a
/// server-generated key; the original filename is only ever metadata.
model File {
  id               String    @id @default(uuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String    @unique // server generated, never derived from user input
  checksum         String // sha256 hex of the content
  createdAt        DateTime  @default(now())
  deletedAt        DateTime? // soft delete

  shares         Share[]
  noteFiles      NoteFile[]
  auditEvents    AuditEvent[]

  @@index([ownerId, createdAt])
}

/// A controlled grant of access to exactly one file or one note.
/// Only the SHA-256 of the link token is stored, so a database leak cannot
/// reveal any working link.
model Share {
  id String @id @default(uuid())
  fileId String?
  file   File?  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  noteId String?
  note   Note?  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tokenHash String @unique // sha256(link token); raw token is never stored

  expiresAt      DateTime?
  allowDownload  Boolean  @default(true)
  maxAccesses    Int? // null = unlimited
  accessCount    Int      @default(0)
  downloadCount  Int      @default(0)
  passwordHash   String? // optional share password (salted hash)
  oneTime        Boolean  @default(false)
  strict         Boolean  @default(false) // stricter recipient session binding
  revokedAt      DateTime?
  consumedAt     DateTime? // set when a one-time share is used
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recipientSessions RecipientSession[]
  auditEvents       AuditEvent[]

  @@index([ownerId, createdAt])
  @@index([fileId])
  @@index([noteId])
}

/// Server-side session for a recipient that opened a share.
/// The client holds the raw session secret; only its hash is stored.
/// IP/user-agent are recorded as risk signals, never as identity.
model RecipientSession {
  id      String @id @default(uuid())
  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  tokenHash String @unique // sha256(session secret)

  createdAt    DateTime @default(now())
  lastAccessAt DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  ip        String?
  userAgent String?

  auditEvents AuditEvent[]

  @@index([shareId])
}

/// Markdown note owned by a user; can be shared with the same Share
/// architecture as files (exactly one of fileId/noteId per share).
model Note {
  id      String  @id @default(uuid())
  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title   String
  content String  @default("") // markdown source
  tags    String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  files       NoteFile[]
  shares       Share[]
  auditEvents AuditEvent[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, deletedAt])
  @@index([tags], type: Gin)
}

/// Join table linking a note to attached uploaded files.
model NoteFile {
  id      String   @id @default(uuid())
  noteId  String
  fileId  String
  note    Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  file    File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([noteId, fileId])
  @@index([fileId])
}

enum AuditEventType {
  USER_REGISTERED
  USER_LOGIN
  LOGIN_FAILED
  LOGIN_RATE_LIMITED
  USER_LOGOUT
  FILE_UPLOADED
  FILE_DELETED
  SHARE_CREATED
  SHARE_OPENED
  SHARE_DOWNLOADED
  SHARE_REVOKED
  ACCESS_DENIED
  RECIPIENT_SESSION_CREATED
  SESSION_CHANGED
  NOTE_CREATED
  NOTE_DELETED
  USER_SUSPENDED
  USER_REACTIVATED
  SHARE_REVOKED_BY_ADMIN
}

/// Append-only security trail.
/// Retention: rows cascade when their share/file/user is deleted (privacy
/// first); otherwise keep for 180 days and prune with a scheduled job.
model AuditEvent {
  id    String          @id @default(uuid())
  type  AuditEventType
  actorUserId           String?
  shareId               String?
  fileId                String?
  noteId                String?
  recipientSessionId    String?
  ip                    String?
  userAgent             String?
  metadata              Json?
  createdAt             DateTime @default(now())

  actor   User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  share   Share?            @relation(fields: [shareId], references: [id], onDelete: Cascade)
  file    File?             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  note    Note?             @relation(fields: [noteId], references: [id], onDelete: SetNull)
  session RecipientSession? @relation(fields: [recipientSessionId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([shareId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([noteId, createdAt])
}
