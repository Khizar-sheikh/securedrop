{
  "name": "@securedrop/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SecureDrop backend API",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "admin:promote": "node scripts/promote-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3",
    "eslint": "9.39.5",
    "jest": "^30.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.0",
    "typescript": "5.9.3"
  }
}
